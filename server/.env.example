PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/cloudvault?retryWrites=true&w=majority
JWT_SECRET=change-this-to-a-long-random-secret-at-least-64-chars
S3_REGION=us-east-1
S3_BUCKET_NAME=your-cloudvault-bucket-name
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
ALLOWED_ORIGINS=http://localhost:5173,https://your-amplify-app.amplifyapp.com
MAX_FILE_SIZE=26214400
STORAGE_QUOTA=1073741824
