# ==============================================================================
# CloudVault - Environment Configuration Template
# ==============================================================================

# Backend Configuration (server/.env)
PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/cloudvault?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_secure_random_secret_at_least_64_characters_long_placeholder
S3_REGION=us-east-1
S3_BUCKET_NAME=your-cloudvault-bucket-name
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
ALLOWED_ORIGINS=http://localhost:5173,https://main.d123456abcdef.amplifyapp.com
MAX_FILE_SIZE=26214400
STORAGE_QUOTA=1073741824

# Frontend Configuration (client/.env or Amplify environment variables)
VITE_API_URL=https://tnn1ahid34.execute-api.ap-southeast-2.amazonaws.com
VITE_API_BASE_URL=https://tnn1ahid34.execute-api.ap-southeast-2.amazonaws.com
